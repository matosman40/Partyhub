# Caddy : HTTPS sur le réseau local avec un certificat interne.
#
# L'adresse du serveur est lue dans PARTYHUB_HOST (fichier .env à côté de compose.yaml), par exemple 192.168.1.156.
# Le certificat est signé par l'autorité interne de Caddy : son certificat racine se télécharge depuis la page
# /certificat de PartyHub, puis s'installe sur les téléphones et tablettes (voir docs/HTTPS-LAN.md).

{
	# Un téléphone qui se connecte par adresse IP n'envoie pas de nom (SNI) pendant la poignée de main TLS.
	# Sans ce réglage, Caddy ne sait pas quel certificat présenter et coupe : « alert internal error ».
	default_sni {$PARTYHUB_HOST}
}

https://{$PARTYHUB_HOST} {
	tls internal
	encode zstd gzip

	# Certificat racine : public, servi par Caddy lui-même. Il est téléchargeable avant toute installation.
	# CADDY_CA_DIR n'est fourni que pour les tests ; sur Docker, le chemin par défaut est celui de l'image.
	handle /certificat/racine.crt {
		root * {$CADDY_CA_DIR:/data/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition attachment;filename=partyhub-autorite-locale.crt
		file_server
	}

	handle {
		reverse_proxy partyhub:8282
	}
}

# Certificat racine en clair, à télécharger AVANT toute installation : http://<adresse>:8281/certificat/racine.crt.
# Le navigateur n'a alors aucun avertissement à accepter. Le fichier ne contient aucune clé privée.
# Tout le reste du port 8281 renvoie vers HTTPS.
http://{$PARTYHUB_HOST}:8281 {
	handle /certificat/racine.crt {
		root * {$CADDY_CA_DIR:/data/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition attachment;filename=partyhub-autorite-locale.crt
		file_server
	}

	handle {
		redir https://{$PARTYHUB_HOST}{uri} permanent
	}
}
