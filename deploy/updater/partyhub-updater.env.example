# Réglages du service de mise à jour de PartyHub (copié dans /etc/partyhub-updater.env par install.sh).
# Dossier de l’installation : le dépôt git cloné (voir README.md).
PARTYHUB_DIR=/DATA/AppData/partyhub
# Fichier Compose utilisé pour démarrer PartyHub.
PARTYHUB_COMPOSE_FILE=compose.yaml
# Volume Docker des données (défini dans compose.yaml).
PARTYHUB_VOLUME=partyhub-data
# Adresse de contrôle après la mise à jour : l’HTTPS de PartyHub, avec l’adresse du serveur (PARTYHUB_HOST du .env).
PARTYHUB_HEALTH_URL=https://192.168.1.156/api/health
