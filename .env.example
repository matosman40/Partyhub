# Copier ce fichier en .env puis adapter les valeurs.
# Toutes les variables sont facultatives sauf indication contraire.

# Port publié sur la machine hôte (CasaOS / Docker Compose).
PARTYHUB_PORT=8282

# Mot de passe de l'administration.
# Si absent : un mot de passe aléatoire est généré au premier démarrage
# et écrit dans /data/admin-password.txt (à lire puis à supprimer).
# S'il est défini, il fait toujours foi au démarrage.
ADMIN_PASSWORD=

# Jeton GitHub (lecture des releases). Requis seulement pour les dépôts privés de jeux.
# GITHUB_TOKEN=

# Niveau de journalisation : fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Adresse du serveur pour le HTTPS du réseau local (surcouche deploy/https, voir docs/HTTPS-LAN.md).
# Le micro et la caméra des téléphones ne fonctionnent qu'en HTTPS. Exemple : 192.168.1.156
# PARTYHUB_HOST=

# Mettre à true uniquement si l'accès se fait en HTTPS (reverse proxy ou surcouche deploy/https).
COOKIE_SECURE=false

# Proxys de confiance : pour retrouver l'adresse réelle des joueurs derrière un reverse proxy.
# loopback = proxy installé sur la même machine (défaut). Derrière Docker, indiquez le réseau du
# proxy, par exemple 172.16.0.0/12. Ne mettez jamais un réseau plus large que nécessaire.
TRUST_PROXY=loopback

# Sauvegarde automatique de la base : intervalle en heures (0 = désactivée) et nombre de copies gardées.
DB_BACKUP_EVERY_HOURS=24
DB_BACKUP_KEEP=7
