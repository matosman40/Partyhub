# Copier ce fichier en .env puis adapter les valeurs.
# Toutes les variables sont facultatives sauf indication contraire.

# Port publié sur la machine hôte (CasaOS / Docker Compose).
PARTYHUB_PORT=8282

# Mot de passe de l'administration.
# Si absent : un mot de passe aléatoire est généré au premier démarrage
# et écrit dans /data/admin-password.txt (à lire puis à supprimer).
# S'il est défini, il fait toujours foi au démarrage.
ADMIN_PASSWORD=

# Jeton GitHub (lecture des releases). Requis seulement pour les dépôts privés de jeux.
# GITHUB_TOKEN=

# Niveau de journalisation : fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# LOG_DIR=/data/logs
# LOG_MAX_MB=5
# LOG_FILES=6

# Adresse du serveur pour le HTTPS du réseau local (surcouche deploy/https, voir docs/HTTPS-LAN.md).
# Le micro et la caméra des téléphones ne fonctionnent qu'en HTTPS. Exemple : 192.168.1.156
# PARTYHUB_HOST=
# Port HTTPS publié par la surcouche (443 par défaut).
# PARTYHUB_HTTPS_PORT=443

# Mettre à true uniquement si l'accès se fait en HTTPS (reverse proxy ou surcouche deploy/https).
COOKIE_SECURE=false

# Proxys de confiance : pour retrouver l'adresse réelle des joueurs derrière un reverse proxy.
# loopback = proxy installé sur la même machine (défaut). Derrière Docker, indiquez le réseau du
# proxy, par exemple 172.16.0.0/12. Ne mettez jamais un réseau plus large que nécessaire.
TRUST_PROXY=loopback

# Sauvegarde automatique de la base : intervalle en heures (0 = désactivée) et nombre de copies gardées.
DB_BACKUP_EVERY_HOURS=24
DB_BACKUP_KEEP=7

# Histoire écrite par une IA, pour le jeu « Aventure IA ». Facultatif : sans clé, le jeu joue une histoire de secours.
# AI_PROVIDER liste un ou plusieurs fournisseurs par ordre de préférence, séparés par des virgules (ex. groq,anthropic).
# Le premier qui n'a pas atteint son plafond répond ; en cas d'échec, le suivant prend le relais.
# Sans AI_PROVIDER, le premier fournisseur dont la clé est présente est utilisé.
# Fournisseurs : anthropic, openai, groq, openrouter, mistral, cerebras, gemini, custom. Voir le README.
# Les clés restent sur le serveur : elles ne sont jamais envoyées aux téléphones ni à l'écran.
# Une clé peut aussi être saisie dans l'administration (Système → Intelligence artificielle) : elle prend alors le pas sur celle-ci.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
# Autre service compatible avec l'API OpenAI : adresse de sa racine, sans /v1/chat/completions.
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_BASE_URL=
# AI_CUSTOM_MODEL=
# Modèles. Obligatoires pour les fournisseurs gratuits ; Anthropic et OpenAI ont un modèle par défaut.
# AI_ANTHROPIC_MODEL=claude-haiku-5-5
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_GROQ_MODEL=
# AI_OPENROUTER_MODEL=
# AI_MISTRAL_MODEL=
# AI_CEREBRAS_MODEL=
# AI_GEMINI_MODEL=
# Plafonds journaliers (24 heures glissantes) : pour rester dans un palier gratuit, ou borner un coût.
# AI_ANTHROPIC_MAX_CALLS_PER_DAY=
# AI_OPENAI_MAX_CALLS_PER_DAY=
# AI_GROQ_MAX_CALLS_PER_DAY=
# AI_OPENROUTER_MAX_CALLS_PER_DAY=
# AI_MISTRAL_MAX_CALLS_PER_DAY=
# AI_CEREBRAS_MAX_CALLS_PER_DAY=
# AI_GEMINI_MAX_CALLS_PER_DAY=
# AI_CUSTOM_MAX_CALLS_PER_DAY=
# Plafonds globaux, tous fournisseurs confondus.
# AI_TIMEOUT_MS=30000
# AI_MAX_CALLS_PER_HOUR=300

# Images pour « Aventure IA » : portraits des personnages et fonds de décor, gardés dans une bibliothèque partagée.
# Facultatif : sans clé, les personnages restent dessinés à partir de leur nom. Les clés restent sur le serveur.
# Cloudflare Workers AI (FLUX.1 schnell) : gratuit dans la limite d'un quota quotidien.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ModelScope (Qwen-Image) : service réservé à un usage non commercial, avec un compte Alibaba vérifié.
# MODELSCOPE_API_KEY=
# Déclaration d'usage non commercial : sans cette ligne à 1, ModelScope reste désactivé, même avec la clé.
# MODELSCOPE_ALLOW_NONCOMMERCIAL=1
# Ordre d'appel, séparé par des virgules. Par défaut : les fournisseurs dont la clé est présente, Cloudflare d'abord.
# IMAGE_PROVIDERS=cloudflare,modelscope
# Nombre maximal d'images générées par jour, tous fournisseurs confondus.
# IMAGE_MAX_PER_DAY=150
# Délai maximal pour une image, en millisecondes.
# IMAGE_TIMEOUT_MS=60000

# Jeux intégrés sur une installation neuve : off par défaut, on pour les activer.
# BUILTIN_GAMES=off
